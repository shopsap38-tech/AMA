# -----------------------------------------------------------------------------
# Configuration d'environnement QMS (copiez en .env et adaptez).
# Ces variables surchargent les valeurs par défaut de config/config.php.
# Chargez-les via votre serveur web, votre process manager ou un loader dotenv.
# -----------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
APP_URL=

# Base de données
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qms
DB_USER=root
DB_PASSWORD=

# Notifications email (point d'extension)
MAIL_ENABLED=false
MAIL_FROM=qualite@entreprise.com
MAIL_FROM_NAME="QMS - Service Qualité"
